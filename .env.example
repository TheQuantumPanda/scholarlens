# Choose the default LLM transport: groq or ollama.
SCHOLARLENS_LLM_PROVIDER=groq

# Groq hosted inference. Keep the real key only in your local .env.
GROQ_API_KEY=
SCHOLARLENS_GROQ_MODEL=qwen/qwen3.8-27b
SCHOLARLENS_GROQ_TIMEOUT_SECONDS=240

# Local Ollama inference (fallback option).
SCHOLARLENS_OLLAMA_BASE_URL=http://localhost:11434
SCHOLARLENS_OLLAMA_MODEL=qwen3:4b
SCHOLARLENS_OLLAMA_TIMEOUT_SECONDS=240
